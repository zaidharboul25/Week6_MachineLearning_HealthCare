data/raw/
data/interim/
data/processed/
datasets/
*.xlsx
*.zip
*.parquet
data/**/*.csv
datasets/**/*.csv
!reports/*.csv

# Model artifacts and binaries
artifacts/*.joblib
artifacts/*.pkl
artifacts/*.onnx
artifacts/*.bin
*.joblib
*.pkl

